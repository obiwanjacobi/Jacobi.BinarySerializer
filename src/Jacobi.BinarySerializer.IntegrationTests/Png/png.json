{
  // binary schema for the png image file format.
  "name": "Png",
  "processorDefs": [
    {
      "name": "chunkType",
      "processor": "sys.map",
      "logical": "Int32",
      "0": "IHDR",
      "1": "PLTE",
      "2": "IDAT",
      "3": "IEND",
      "4": null
    }
  ],
  "members": [
    {
      "name": "Png",
      "kind": "group",
      "processors": [
        {
          "name": "sys.bytepacker",
          "byteorder": "big"
        }
      ],
      "members": [
        {
          "name": "Signature",
          "kind": "field",
          "datatype": "Bytes",
          "byteLength": 8,
          "value": "0x89504E470D0A1A0A"
        },
        {
          "name": "Chunk",
          "kind": "repeat",
          "members": [
            {
              "name": "Length",
              "kind": "field",
              "datatype": "UInt32"
            },
            {
              "name": "Body",
              "kind": "group",
              "processors": [
                { "name": "sys.bytepacker" },
                { "name": "sys.crc" }
              ],
              "members": [
                {
                  "name": "Type",
                  "kind": "field",
                  "datatype": "String",
                  "processors": [
                    {
                      "name": "sys.string",
                      "byteLength": 4,
                      "encoding": "ascii"
                    }
                  ]
                },
                {
                  "name": "Data",
                  "kind": "choice",
                  "selectedIndex": { "ref": "Png.Chunk[].Body.Type" },
                  "byteSize": { "ref": "Png.Chunk[].Length" },
                  "valueProcessors": [ { "name": "ref:chunkType" } ],
                  "members": [
                    {
                      "name": "Header",
                      "kind": "group",
                      "members": [
                        {
                          "name": "Width",
                          "kind": "field",
                          "datatype": "UInt32"
                        },
                        {
                          "name": "Height",
                          "kind": "field",
                          "datatype": "UInt32"
                        },
                        {
                          "name": "BitDepth",
                          "kind": "field",
                          "datatype": "UInt8"
                        },
                        {
                          "name": "ColorType",
                          "kind": "field",
                          "datatype": "UInt8"
                        },
                        {
                          "name": "Compression",
                          "kind": "field",
                          "datatype": "UInt8"
                        },
                        {
                          "name": "Filter",
                          "kind": "field",
                          "datatype": "UInt8"
                        },
                        {
                          "name": "Interlace",
                          "kind": "field",
                          "datatype": "UInt8"
                        }
                      ]
                    },
                    {
                      "name": "Palette",
                      "kind": "field",
                      "datatype": "Bytes"
                    },
                    {
                      "name": "ImageData",
                      "kind": "field",
                      "datatype": "Bytes"
                    },
                    {
                      "name": "End",
                      "kind": "group",
                      "members": []
                    },
                    {
                      "name": "Unknown",
                      "kind": "field",
                      "datatype": "Bytes"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
